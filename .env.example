# Copy this file to .env and fill it in. Never commit .env.
#   cp .env.example .env

# --- Required -------------------------------------------------------------
# From dashboard.sarvam.ai. This is the only secret in the project.
SARVAM_API_KEY=

# --- Models ---------------------------------------------------------------
# Check the ids your key can use first. Works on every platform:
#   python -c "from pipeline import llm; print(chr(10).join(llm.list_models()))"
# Bash users can also do: set -a; . ./.env; set +a; curl -H
#   "api-subscription-key: $SARVAM_API_KEY" https://api.sarvam.ai/v2/models
# Both roles can be the same model; using a cheaper one for "fast" saves money.
LLM_MODEL_STRONG=sarvam-105b
LLM_MODEL_FAST=sarvam-105b

# Always sent explicitly. The API default is 2048, which truncates a quiz.
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3
LLM_RETRIES=3
LLM_TIMEOUT=90

# --- Translation ----------------------------------------------------------
# mayura:v1 = 11 languages, 1,000 characters per request.
# sarvam-translate:v1 = all 22 scheduled languages, 2,000 characters, formal only.
TRANSLATE_MODEL=mayura:v1
TRANSLATE_CHUNK_CHARS=900
TRANSLATE_TO=hi-IN

# --- Storage --------------------------------------------------------------
DB_PATH=data/runs.db
OUTPUT_DIR=outputs

# Optional. Leave blank to use SQLite only.
# Run sql/schema.sql in the Supabase SQL editor before filling these in.
# SUPABASE_KEY must be the service_role key: row-level security on the runs
# table blocks inserts from the anon key, and the app would fail silently.
SUPABASE_URL=
SUPABASE_KEY=

# --- Pipeline -------------------------------------------------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
PASS_SCORE=4
MAX_REPAIRS=2

# Extraction runs on groups of chunks, packed up to EXTRACT_WINDOW characters.
# A long document is then sampled down to at most MAX_EXTRACT_CALLS groups.
EXTRACT_WINDOW=6000
MAX_EXTRACT_CALLS=6

# Endpoint overrides - only change these if Sarvam moves an endpoint.
# SARVAM_CHAT_URL=https://api.sarvam.ai/v2/chat/completions
# SARVAM_MODELS_URL=https://api.sarvam.ai/v2/models
# SARVAM_TRANSLATE_URL=https://api.sarvam.ai/translate

# --- Cost -----------------------------------------------------------------
# Rupees per 1,000,000 tokens. These are sarvam-105b's published list price at
# the time of writing - check the pricing page and put your own numbers here.
RATE_IN_PER_M=10
RATE_OUT_PER_M=25

# --- Web bridge -----------------------------------------------------------
# Must match the page origin exactly: https, no trailing slash.
# Local: http://localhost:8000
# Deployed: https://<username>.github.io
WEB_ORIGIN=http://localhost:8000
MAX_UPLOAD_BYTES=10485760
