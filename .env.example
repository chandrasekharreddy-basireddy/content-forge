# Copy this file to .env and fill it in. Never commit .env.
#   cp .env.example .env

# --- Required -------------------------------------------------------------
# From dashboard.sarvam.ai. This is the only secret in the project.
SARVAM_API_KEY=

# --- Models ---------------------------------------------------------------
# Check the ids your key can use first:
#   curl -H "api-subscription-key: $SARVAM_API_KEY" https://api.sarvam.ai/v2/models
# Both roles can be the same model; using a cheaper one for "fast" saves money.
LLM_MODEL_STRONG=sarvam-105b
LLM_MODEL_FAST=sarvam-105b

# Always sent explicitly. The API default is 2048, which truncates a quiz.
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3
LLM_RETRIES=3
LLM_TIMEOUT=90

# --- Translation ----------------------------------------------------------
# mayura:v1 = 11 languages, 1,000 characters per request.
# sarvam-translate:v1 = all 22 scheduled languages, 2,000 characters, formal only.
TRANSLATE_MODEL=mayura:v1
TRANSLATE_CHUNK_CHARS=900
TRANSLATE_TO=hi-IN

# --- Storage --------------------------------------------------------------
DB_PATH=data/runs.db
OUTPUT_DIR=outputs

# Optional. Leave blank to use SQLite only.
# Run sql/schema.sql in the Supabase SQL editor before filling these in.
SUPABASE_URL=
SUPABASE_KEY=

# --- Pipeline -------------------------------------------------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
PASS_SCORE=4
MAX_REPAIRS=2

# --- Cost -----------------------------------------------------------------
# Rupees per 1,000,000 tokens. These are sarvam-105b's published list price at
# the time of writing - check the pricing page and put your own numbers here.
RATE_IN_PER_M=10
RATE_OUT_PER_M=25

# --- Web bridge -----------------------------------------------------------
# Must match the page origin exactly: https, no trailing slash.
# Local: http://localhost:8000
# Deployed: https://<username>.github.io
WEB_ORIGIN=http://localhost:8000
MAX_UPLOAD_BYTES=10485760
