// Content Forge - Power BI measures
// ---------------------------------------------------------------------------
// How to use these:
//   1. In the Streamlit app, open the History tab and click "Download runs as CSV".
//   2. In Power BI Desktop: Get Data > Text/CSV, and load that file as a table
//      called runs.
//   3. Home > Enter Data, paste each measure below, and give it the name above it.
//   4. Build the four visuals listed at the bottom of this file.
//
// Power BI Desktop is Windows-only. Plan for that in week one, not week five.

// --- Volume ----------------------------------------------------------------

Total Runs = COUNTROWS ( runs )

Outputs Produced = SUM ( runs[outputs_count] )

Documents Processed = DISTINCTCOUNT ( runs[doc_name] )

Words Processed = SUM ( runs[words] )

// --- Quality ---------------------------------------------------------------

Avg Critic Score =
AVERAGE ( runs[avg_score] )

// The share of runs where every output cleared the critic. This is the number
// to quote in the report; the average score hides a single bad output.
Clean Run Rate =
DIVIDE (
    CALCULATE ( COUNTROWS ( runs ), runs[status] = "ok" ),
    [Total Runs]
)

// Runs where at least one output needed a repair or was flagged. A rising
// trend here means the prompts drifted, not that the documents got harder.
Partial Run Rate =
DIVIDE (
    CALCULATE ( COUNTROWS ( runs ), runs[status] = "partial" ),
    [Total Runs]
)

// --- Cost ------------------------------------------------------------------

Total Cost INR = SUM ( runs[cost_inr] )

Cost per Run = DIVIDE ( [Total Cost INR], [Total Runs] )

Cost per Thousand Words =
DIVIDE ( [Total Cost INR], DIVIDE ( [Words Processed], 1000 ) )

// --- Speed -----------------------------------------------------------------

Avg Seconds per Run =
DIVIDE ( AVERAGE ( runs[duration_ms] ), 1000 )

Seconds per Thousand Words =
DIVIDE ( [Avg Seconds per Run], DIVIDE ( AVERAGE ( runs[words] ), 1000 ) )

// --- Trends ----------------------------------------------------------------

// Put this on a line chart's X axis after marking runs[created_at] as a date.
Runs by Day =
CALCULATE ( [Total Runs], ALLEXCEPT ( runs, runs[created_at].[Date] ) )

Score Last 7 Runs =
CALCULATE (
    AVERAGE ( runs[avg_score] ),
    TOPN ( 7, runs, runs[created_at], DESC )
)

// --- Suggested page layout -------------------------------------------------
//
// Row 1  KPI cards: Total Runs | Clean Run Rate | Avg Critic Score | Total Cost INR
// Row 2  Line chart: Avg Critic Score by created_at (day) - the quality trend
// Row 3  Column chart: runs by status (ok / partial / failed) - where it breaks
// Row 4  Scatter: words (X) vs cost_inr (Y), coloured by depth - the cost story
//        plus a table of the five most expensive runs
//
// One page is enough. A second page with the evaluation results
// (evals/results.csv) is a nice extra if you have the time.
